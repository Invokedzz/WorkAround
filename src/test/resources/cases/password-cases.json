{
  "version": "1.0",
  "passwords": [
    {
      "password": "valid",
      "expected": "bypass",
      "note": "only letters"
    },
    {
      "password": "12345",
      "expected": "bypass",
      "note": "only numbers"
    },
    {
      "password": "valid12345",
      "expected": "bypass",
      "note": "letters and numbers"
    },
    {
      "password": "",
      "expected": "bypass",
      "note": "empty password"
    },
    {
      "password": "VALID",
      "expected": "bypass",
      "note": "only uppercase chars"
    },
    {
      "password": "VaLid",
      "expected": "bypass",
      "note": "uppercase and lowercase"
    },
    {
      "password": "VALID123",
      "expected": "bypass",
      "note": "uppercase with numbers"
    },
    {
      "password": "vAliD12345",
      "expected": "bypass",
      "note": "uppercase, lowercase and numbers"
    },
    {
      "password": "@notvalid",
      "expected": "block",
      "note": "lowercase, special character"
    },
    {
      "password": "_123",
      "expected": "block",
      "note": "numbers, special character"
    },
    {
      "password": "_@_$",
      "expected": "block",
      "note": "only special characters"
    },
    {
      "password": "<alert>hello!</alert>",
      "expected": "block",
      "note": "possible JS injection"
    },
    {
      "password": "<b>bold test</b>\n<i>italic test</i>\n<h1>heading test</h1>\n",
      "expected": "block",
      "note": "html injection"
    }
  ]
}